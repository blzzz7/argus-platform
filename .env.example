# Argus ITDR — environment configuration template
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Supabase (persistence: events, resolved users, integration config) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Microsoft Entra ID / MSAL (Red Team engine + real remediation) ---
ARGUS_TENANT_ID=
ARGUS_CLIENT_ID=
ARGUS_CLIENT_SECRET=
ARGUS_DOMAIN=

# --- Panel login (SHA-256 hashed password, never plaintext) ---
ARGUS_ADMIN_USER=
ARGUS_ADMIN_HASH=

# --- Argus -> Wazuh ingest bridge (only needed if Wazuh runs on a separate
#     machine, e.g. Streamlit Cloud -> home lab via receiver.py + ngrok) ---
ARGUS_INGEST_URL=
ARGUS_INGEST_TOKEN=

# --- Wazuh Indexer (audit-trail reads) ---
WAZUH_INDEXER_BASE=https://localhost:9200
WAZUH_ALERTS_INDEX=wazuh-alerts-*
WAZUH_USERNAME=admin
WAZUH_PASSWORD=
WAZUH_VERIFY_SSL=false

# --- Feature flags ---
# false = remediation buttons only log to SIEM (no real Entra ID change)
# true  = remediation buttons make REAL changes against the tenant above
ENABLE_REAL_REMEDIATION=false

# --- AI / LLM (Sigma rule generation + sidebar chatbot) ---
# AI_MODE=local uses Ollama; any other value (groq, openai, cloud, ...)
# uses the OpenAI-compatible remote path below.
AI_MODE=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Local-only fallback (AI_MODE=local)
OLLAMA_MODEL=llama3
OLLAMA_HOST=http://127.0.0.1:11434
